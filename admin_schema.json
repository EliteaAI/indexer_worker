{
  "$schema": "https://elitea.ai/admin-config-schema/v1",
  "plugin": "indexer_worker",
  "properties": {
    "sdk_dev_reload": {
      "type": "boolean",
      "title": "SDK Hot Reload",
      "description": "When enabled, the SDK is reloaded from disk on every agent run instead of using cached modules. Useful during SDK development to pick up code changes instantly without restarting the service. Keep disabled in production for better performance.",
      "path": "sdk_dev_reload",
      "section": "runtime",
      "default": false,
      "requires_restart": false
    },
    "allow_tool_call_truncation": {
      "type": "boolean",
      "title": "Bound Oversized Tool Results",
      "description": "When enabled, a tool result larger than the limit below is truncated with an explicit marker before it reaches agent state, the event stream, the database and the LLM context. Disable to pass every result through unchanged (previous behaviour).",
      "path": "allow_tool_call_truncation",
      "section": "runtime",
      "default": true,
      "requires_restart": false
    },
    "tool_call_truncation_limit": {
      "type": "integer",
      "title": "Tool Result Limit (characters)",
      "description": "Maximum approximate size of a single tool result, in characters. Aligned with the SDK bounded-read cap. Only applies when bounding is enabled.",
      "path": "tool_call_truncation_limit",
      "section": "runtime",
      "default": 200000,
      "minimum": 1000,
      "requires_restart": false
    },
    "tool_call_truncation_limit_per_toolkit": {
      "type": "object",
      "title": "Tool Result Limit Per Toolkit Type",
      "description": "Per-toolkit-type overrides of the limit above, for toolkits whose large output is legitimate (retrieval, exports). Keys are toolkit types, values are character limits. Toolkit types not listed use the global limit.",
      "path": "tool_call_truncation_limit_per_toolkit",
      "section": "runtime",
      "default": {},
      "requires_restart": false,
      "value_schema": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "mcp_servers": {
      "type": "object",
      "title": "MCP Server Definitions",
      "description": "Pre-configured MCP servers that appear as selectable toolkits. Supports stdio (local subprocess) and http (remote) server types. Set \"group\" on an entry (\"Elitea\", \"EPAM\", or \"Other\") to place it under that sub-section in the toolkit picker and Types filter; omitted entries default to \"Other\".",
      "path": "mcp_servers",
      "section": "mcp_servers",
      "default": {},
      "requires_restart": false,
      "value_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "http",
                "stdio"
              ]
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "runtime": {
              "type": "string",
              "enum": [
                "npm",
                "python"
              ]
            },
            "package": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "display_name": {
              "type": "string"
            },
            "icon_url": {
              "type": "string"
            },
            "group": {
              "type": "string",
              "enum": [
                "Elitea",
                "EPAM",
                "Other"
              ]
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "env_mapping": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ssl_verify": {
              "type": "boolean"
            },
            "stateful": {
              "type": "boolean"
            },
            "config_schema": {
              "type": "object"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "selected_tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded_tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "http"
                  }
                }
              },
              "then": {
                "required": [
                  "url"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "stdio"
                  }
                }
              },
              "then": {
                "required": [
                  "command"
                ]
              }
            }
          ],
          "additionalProperties": true
        }
      }
    }
  }
}
